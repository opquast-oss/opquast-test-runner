{
  "name": "@opquast/test-runner",
  "version": "2.0.0-alpha.1",
  "description": "Opquast test engine — evaluates web quality rules against a DOM and sidecar data",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js"
    },
    "./rulesets": {
      "types": "./dist/rulesets.d.ts",
      "import": "./dist/rulesets.js"
    }
  },
  "publishConfig": {
    "@opquast:registry": "https://gitlab.com/api/v4/projects/opquast%2Ftest-runner/packages/npm/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "corpus": "node test/golden/lib/sources.mjs",
    "test": "node --test \"test/golden/**/*.test.mjs\"",
    "prepublishOnly": "npm run check && npm run build"
  },
  "author": "Temesis SAS (https://www.temesis.com/)",
  "contributors": [
    "Fabrice Bonny <fabrice.bonny@temesis.com>",
    "Mickael Hoareau <mickael.hoareau@temesis.com>",
    "Olivier Meunier <olivier.meunier@temesis.com>",
    "Samuel Martin <samuel.martin@temesis.com>",
    "Laurent Jouanneau <laurent@innophi.com>"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/opquast/test-runner.git"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opquast",
    "web-quality",
    "accessibility",
    "audit",
    "testing"
  ],
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
